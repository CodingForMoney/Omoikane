{
  "name": "omoikane",
  "version": "0.0.5",
  "description": "Durable TypeScript Agent Runtime built on the OpenAI Agents SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    }
  },
  "bin": {
    "omoikane": "dist/bin/cli.js",
    "omoikane-runtime": "dist/bin/runtime.js",
    "omoikane-migrate": "dist/bin/migrate.js"
  },
  "files": [
    "dist",
    "migrations/*.sql",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "dev": "node --import tsx src/bin/runtime.ts",
    "start": "node dist/bin/runtime.js",
    "migrate": "node --import tsx src/bin/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:postgres:docker": "node --import tsx scripts/postgres-test.ts",
    "test:mimo": "node --import tsx scripts/mimo-e2e.ts",
    "test:e2e:structured-output": "node --import tsx scripts/structured-output-e2e.ts",
    "test:e2e:mimo": "vitest run --config vitest.e2e.config.ts test/e2e/mimo-runtime.e2e.test.ts",
    "test:e2e:mimo-audio": "node --env-file=.env --import tsx scripts/mimo-audio-e2e.ts",
    "test:e2e:codex-bridge-compaction": "vitest run --config vitest.e2e.config.ts test/e2e/codex-bridge-compaction.e2e.test.ts",
    "test:e2e:compaction-100k": "vitest run --config vitest.compaction-100k.config.ts test/e2e/mimo-compaction-100k.e2e.test.ts",
    "eval:compaction": "node --import tsx scripts/compaction-semantic-eval.ts",
    "test:sandbox": "node --import tsx scripts/sandbox-smoke.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts' 'examples/**/*.ts' 'vitest*.config.ts'",
    "example:mcp": "node --import tsx examples/business-mcp/server.ts",
    "prepack": "npm run check && npm test && npm run build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/google": "^4.0.54",
    "@electric-sql/pglite": "^0.3.10",
    "@fastify/multipart": "^9.2.1",
    "@huggingface/jinja": "^0.5.9",
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openai/agents": "0.17.0",
    "@openai/agents-extensions": "0.17.0",
    "@openai/agents-openai": "0.17.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "fast-glob": "^3.3.3",
    "fastify": "^5.6.0",
    "openai": "^7.2.0",
    "pg": "^8.16.3",
    "uuidv7": "^1.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodingForMoney/Omoikane.git"
  },
  "license": "MIT",
  "keywords": [
    "openai",
    "agents",
    "agent-runtime",
    "typescript",
    "mcp"
  ]
}
