# One Omoikane process serves one local business system.
OMOIKANE_DATA_DIR=./var
OMOIKANE_HOST=127.0.0.1
OMOIKANE_PORT=8000
# Browser-visible base URL used for remote MCP OAuth callbacks.
# OMOIKANE_PUBLIC_BASE_URL=http://127.0.0.1:8000
OMOIKANE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OMOIKANE_RUN_CONCURRENCY=4

# Optional overrides. PGlite and local directories under OMOIKANE_DATA_DIR are
# used when these are omitted.
# OMOIKANE_DATABASE_URL=postgresql://omoikane:password@127.0.0.1:5432/omoikane
# OMOIKANE_ARTIFACT_DIR=./var/artifacts
# OMOIKANE_SKILL_DIR=./var/skills

# The Runtime is unauthenticated. A non-loopback bind must be explicitly enabled
# and placed behind the business system's trusted boundary.
OMOIKANE_ALLOW_REMOTE=false

# Optional. A private local key is generated at ./var/credential.key by default.
# It encrypts stored Provider API keys and remote MCP OAuth state.
# OMOIKANE_CREDENTIAL_FILE=./var/credential.key

OMOIKANE_WORKER_POLL_MS=500
OMOIKANE_RUN_LEASE_SECONDS=60
OMOIKANE_SSE_HEARTBEAT_SECONDS=15
OMOIKANE_SSE_MAX_CONNECTIONS=64
OMOIKANE_SSE_MAX_CONNECTIONS_PER_RUN=8
OMOIKANE_SSE_POLL_FALLBACK_MS=1000
OMOIKANE_MAX_EVENT_PAYLOAD_BYTES=256000
OMOIKANE_DEFAULT_APPROVAL_TIMEOUT_SECONDS=86400
OMOIKANE_TERMINAL_PAYLOAD_TTL_SECONDS=86400
OMOIKANE_EVENT_TTL_SECONDS=604800
OMOIKANE_ARTIFACT_TTL_SECONDS=86400
OMOIKANE_ARTIFACT_MAX_FILE_BYTES=100000000
OMOIKANE_ARTIFACT_MAX_TOTAL_BYTES=1000000000
# Initializes a new database. Existing databases require `omoikane upgrade`.
OMOIKANE_AUTO_MIGRATE=true
# Tracing is Runtime-global and disabled unless an exporter is selected.
# Values: disabled, openai, or custom:<registered-key>.
OMOIKANE_TRACING_EXPORTER=disabled
# OpenAI tracing requires a dedicated key. This variable names the environment
# variable to read; the key itself is never exposed through Runtime status.
# OMOIKANE_TRACING_API_KEY_ENV=OPENAI_TRACING_API_KEY
OMOIKANE_LOG_LEVEL=info
OMOIKANE_BUILD_COMMIT=unknown

# ProviderConnection records may reference credential variables by name.
MIMO_API_KEY=
CODEX_BRIDGE_API_KEY=
