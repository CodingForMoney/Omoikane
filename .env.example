AGENT_ENVIRONMENT=development
AGENT_DATABASE_URL=pglite://./var/omoikane
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_REDIS_URL=
AGENT_ARTIFACT_BACKEND=local
AGENT_ARTIFACT_ROOT=./var/artifacts
AGENT_S3_BUCKET=
AGENT_S3_ENDPOINT_URL=
AGENT_S3_REGION=
AGENT_SKILL_ROOT=./var/skills
AGENT_SANDBOX_ROOT=./var/sandboxes
# Set this when a containerized Worker controls the host Docker socket.
AGENT_SANDBOX_HOST_ROOT=
AGENT_RUN_STATE_SECRET=replace-with-a-long-random-production-secret
AGENT_WORKER_POLL_MS=500
AGENT_RUN_LEASE_SECONDS=60
AGENT_SSE_HEARTBEAT_SECONDS=15
AGENT_MAX_EVENT_PAYLOAD_BYTES=256000
AGENT_DEFAULT_DAILY_BUDGET_USD=
AGENT_DEFAULT_APPROVAL_TIMEOUT_SECONDS=86400
AGENT_AUTO_MIGRATE=true
AGENT_TRACING_DISABLED=true
AGENT_EMBEDDED_WORKER=true
AGENT_RUNTIME_GENERATION=agents-ts-0.17.0-state-1.19
AGENT_BUILD_COMMIT=unknown
AGENT_WEBHOOK_TIMEOUT_MS=10000
AGENT_WEBHOOK_DISPATCH_BATCH_SIZE=100

# ProviderConnection records may reference any credential variable by name.
MIMO_API_KEY=
