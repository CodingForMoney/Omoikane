# Use a unique Compose project name for every business/environment boundary:
COMPOSE_PROJECT_NAME=project-a-dev-omoikane
AGENT_RUNTIME_GENERATION=agents-ts-0.17.0-state-1.19
AGENT_RUN_STATE_SECRET=replace-with-at-least-32-random-bytes
OMOIKANE_SANDBOX_HOST_ROOT=/tmp/project-a-dev-omoikane-sandboxes

# Provider keys are injected into the API/Worker environment by the deploy system.
# Store only the environment-variable name in ProviderConnection records.
OPENAI_API_KEY=
